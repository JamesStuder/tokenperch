<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TokenPerch"
        x:Class="TokenPerch.SettingsWindow"
        x:DataType="local:SettingsViewModel"
        Title="Token Perch Settings"
        Icon="/Assets/tokenperch.png"
        Width="640" Height="560" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TabItem > ScrollViewer > StackPanel">
      <Setter Property="Margin" Value="20,16" />
      <Setter Property="Spacing" Value="12" />
    </Style>
  </Window.Styles>

  <TabControl TabStripPlacement="Left" Padding="0">

    <TabItem Header="General">
      <ScrollViewer>
        <StackPanel>
          <TextBlock Classes="h" Text="Start" />
          <CheckBox Content="Start Token Perch when I log in" IsChecked="{Binding StartAtLogin}" />
          <TextBlock Text="{Binding GeneralStatus}" Classes="dim" FontSize="12"
                     IsVisible="{Binding GeneralStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <TextBlock Classes="h" Text="Panel" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Opens on" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding PanelTabs}" SelectedIndex="{Binding PanelTabIndex}" MinWidth="200" />
          </StackPanel>

          <TextBlock Classes="h" Text="Updates" Margin="0,8,0,0" />
          <CheckBox Content="Check for new versions on GitHub" IsChecked="{Binding CheckForUpdates}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Check now" Command="{Binding CheckUpdatesCommand}" />
            <TextBlock Text="{Binding UpdateCheckStatus}" Classes="dim" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Classes="h" Text="Opening Claude Code" Margin="0,8,0,0" />
          <TextBox Text="{Binding ClaudeOpenCommand}" PlaceholderText="Empty: a terminal running claude" />
          <TextBlock Classes="dim" FontSize="12"
                     Text="The command Open ▸ Claude Code runs (on Linux through sh -c), e.g. a script that opens your usual terminal. The other agents open in a terminal in their session's folder." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Agents">
      <ScrollViewer>
        <StackPanel>
          <TextBlock Classes="dim" FontSize="12"
                     Text="Token Perch reads each agent's own files (read-only). An agent gets a tab once you have used it on this computer." />

          <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <StackPanel Spacing="8">
              <TextBlock Classes="h" Text="Claude Code" />
              <TextBlock Text="{Binding AuthTitle}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AuthDetail}" Classes="dim" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding LoginText}" Command="{Binding LoginCommand}" Classes="accent" />
                <Button Content="{Binding LogoutText}" Command="{Binding LogoutCommand}" IsVisible="{Binding LoggedIn}" />
                <Button Content="Refresh" Command="{Binding RefreshAuthCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding AccountStatus}" Classes="dim"
                         IsVisible="{Binding AccountStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="dim" FontSize="12"
                         Text="Log in again switches the account or renews an expired login. It runs claude auth login in a terminal, which opens your browser." />
              <CheckBox Content="Count sessions waiting for input on the tray icon" IsChecked="{Binding CountClaudeWaiting}" />
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Agents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:AgentSettingVM">
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="14,10" Margin="0,0,0,10" Opacity="{Binding Found, Converter={x:Static local:Converters.FullIf}}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="h" Text="{Binding Name}" />
                    <TextBlock Text="{Binding Status}" Classes="dim" FontSize="12" />
                    <TextBlock Text="{Binding Waiting}" Classes="dim" FontSize="12" />
                    <CheckBox Content="Show its tab in the panel" IsChecked="{Binding ShowTab}" />
                    <CheckBox Content="Count its sessions waiting for you on the tray icon" IsChecked="{Binding CountWaiting}"
                              IsEnabled="{Binding CanCount}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Appearance">
      <ScrollViewer>
        <StackPanel>
          <TextBlock Classes="h" Text="Theme" />
          <ComboBox ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex}" MinWidth="200" />
          <TextBlock Classes="h" Text="Panel colours" Margin="0,8,0,0" />
          <TextBlock Classes="dim" FontSize="12" Text="Tick a colour to use your own instead of the theme's. Changes show in the panel right away." />
          <ItemsControl ItemsSource="{Binding Colors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:ColorSetting">
                <Grid ColumnDefinitions="160,Auto" Margin="0,4">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding Custom}" />
                  <ColorPicker Grid.Column="1" Color="{Binding Color}" IsAlphaEnabled="False" IsAlphaVisible="False" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Reset to theme colours" Command="{Binding ResetColorsCommand}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Support">
      <ScrollViewer>
        <StackPanel>
          <TextBlock Classes="h" Text="Need help?" />
          <TextBlock Classes="dim"
                     Text="Found a bug, have a question or an idea? Open an issue on GitHub. Please include your operating system and, for bugs, the log (About → Open log)." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open a GitHub issue" Command="{Binding IssueCommand}" Classes="accent" />
            <Button Content="Project on GitHub" Command="{Binding ProjectCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="About">
      <ScrollViewer>
        <StackPanel>
          <TextBlock Classes="h" Text="{Binding Version}" />
          <TextBlock Classes="dim" Text="© Studer Works, LLC · MIT license" />
          <TextBlock Classes="dim" FontSize="12"
                     Text="Not affiliated with Anthropic or the makers of the other agents. Formerly Claude Tray." />
          <TextBlock Text="Settings file" FontWeight="SemiBold" Margin="0,8,0,0" />
          <SelectableTextBlock Text="{Binding ConfigPath}" Classes="dim" FontSize="12" />
          <Button Content="Open settings file" Command="{Binding OpenConfigCommand}"
                  ToolTip.Tip="Advanced settings (terminal commands, tmux, model list). Restart the app after editing." />
          <TextBlock Text="Log" FontWeight="SemiBold" Margin="0,8,0,0" />
          <SelectableTextBlock Text="{Binding LogPath}" Classes="dim" FontSize="12" />
          <Button Content="Open log" Command="{Binding OpenLogCommand}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
